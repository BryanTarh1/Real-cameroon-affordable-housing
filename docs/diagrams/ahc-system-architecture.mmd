flowchart TB
  Seeker[Seeker\nBrowse first] --> Public[Public marketplace\nSearch, map, cost cards]
  Supplier[Agent / supplier\nPaid access] --> Agent[Agent workspace\nListings, credits, freshness]
  Moderator[Field Moderator\nAdmin-provisioned] --> Ops[Operations workspace\nEvidence and verification]
  Admin[Admin\nProvisioned] --> Gov[Admin workspace\nGovernance and reconciliation]

  Public --> App[AHC React application]
  Agent --> App
  Ops --> App
  Gov --> App

  App --> API[Express + tRPC API\nRole and payment controls]
  API --> DB[(Managed AHC database)]
  API --> Media[Protected media / share-card service]
  API --> WhatsApp[Tracked WhatsApp deep links]
  API --> Snapshot[Sanitised local test\nsnapshot endpoint]

